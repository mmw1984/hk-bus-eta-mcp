# AI 智能檢索設定（OpenAI 格式）
# 複製此檔案為 .env 並填入實際值

# 是否啟用 AI 智能檢索功能（必填）
# 預設為關閉（false），設定為 true/1/yes 啟用
# 注意：啟用此功能會產生 AI 服務成本
ENABLE_AI_SEARCH=false

# AI API 金鑰（當 ENABLE_AI_SEARCH=true 時必填）
AI_API_KEY=your_api_key_here

# AI API 端點（選填）
# 預設使用智譜 AI (BigModel)：https://open.bigmodel.cn/api/paas/v4
# 可替換為任何與 OpenAI 格式相容的端點，例如：
#   OpenAI:       https://api.openai.com/v1
#   Groq:         https://api.groq.com/openai/v1
#   Ollama:       http://localhost:11434/v1
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# AI 模型名稱（選填）
# 預設：glm-4-flash（智譜 AI 快速模型）
# OpenAI 可用：gpt-4o-mini、gpt-4o
# Groq 可用：llama-3.3-70b-versatile
AI_MODEL=glm-4-flash
